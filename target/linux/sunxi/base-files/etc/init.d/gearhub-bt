#!/bin/sh /etc/rc.common
START=62

start() {
	[ "$(board_name)" = "focalcrest,gearhub" ] || return 0

	# Enable PCF8563 32.768 kHz LPO clock (required by BCM43430 WiFi & BT)
	i2cset -f -y 0 0x51 0x0d 0x80 2>/dev/null || true

	# If brcmfmac probed before the LPO clock was enabled, reload it so wlan0 comes up
	if [ ! -d /sys/class/net/wlan0 ] && grep -q '^brcmfmac ' /proc/modules; then
		rmmod brcmfmac 2>/dev/null || true
		modprobe brcmfmac 2>/dev/null || true
	fi

	[ -s /lib/firmware/brcm/BCM43430A1.hcd ] || return 0
	[ -c /dev/ttyS1 ] || return 0

	# Pulse BT_REG_ON (PD4 = gpiochip0 line 100) and hold high
	gpioset -c gpiochip0 -t 100ms,0 100=0 2>/dev/null || true
	gpioset -z -c gpiochip0 100=1 2>/dev/null || true
	sleep 1

	for _i in 1 2 3; do
		hciattach -s 115200 /dev/ttyS1 bcm43xx 1500000 flow && break
		sleep 1
	done

	for _i in 1 2 3 4 5; do
		if hciconfig hci0 >/dev/null 2>&1; then
			hciconfig hci0 up 2>/dev/null || true
			break
		fi
		sleep 1
	done
}
